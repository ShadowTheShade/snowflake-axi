# snowflake-axi configuration.
# Copy to ~/.config/snowflake-axi/env, fill in, then `chmod 600` it. Never commit a filled-in copy.
# Process env overrides these values; a PAT connection in ~/.snowflake/connections.toml is a fallback.
# Run `snowflake-axi doctor` after editing to verify the connection.

# --- Snowflake SQL API: PAT auth (the default) ---
# Account identifier, e.g. ORG-ACCOUNT. PAT auth also needs a network policy on the user
# covering this machine's egress IP, and the PAT should be minted WITHOUT ROLE_RESTRICTION
# (a role-restricted token disables role switching).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=

# Optional; otherwise taken from the Snowflake user's own defaults:
#SNOWFLAKE_ROLE=
#SNOWFLAKE_DATABASE=
#SNOWFLAKE_SCHEMA=
#SNOWFLAKE_AUTH=pat                  # pat | oauth (defaults to pat whenever a PAT is set)

# --- Snowflake SQL API: browser SSO / OAuth (alternative to the PAT) ---
# Set these instead of the PAT, then run `snowflake-axi login`. Requires a one-time
# CREATE SECURITY INTEGRATION by an admin (see the README's OAuth setup).
#SNOWFLAKE_OAUTH_CLIENT_ID=
#SNOWFLAKE_OAUTH_ROLE_SCOPE=         # optional: pin a session role at login

# --- Snowflake Postgres (the `pg` commands; independent of the SQL API above) ---
#SNOWFLAKE_AXI_PG_HOST=
#SNOWFLAKE_AXI_PG_USER=
#SNOWFLAKE_AXI_PG_PASSWORD=
#SNOWFLAKE_AXI_PG_PORT=5432
#SNOWFLAKE_AXI_PG_DATABASE=postgres
#SNOWFLAKE_AXI_PG_SSLMODE=require    # disable | require | verify-full

# --- Local dbt (`dbt compile/run/build/...`) ---
#SNOWFLAKE_AXI_DBT_TARGET=           # default target in the repo's profiles.yml
#SNOWFLAKE_AXI_MODEL_DIRS=           # colon-separated dbt model dirs (else auto-discovered)
#SNOWFLAKE_AXI_DEFAULT_FILE_FORMAT=  # named file format for `stage read`
